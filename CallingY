    local function DoSpin()
        if not SpinAtivo or not rootPart then return end
        SpinAngle = SpinAngle + (0.016) * SpinSpeed * 2
        rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, SpinAngle, 0)
    end

    local function DoSkillMode()
        if not SkillModeAtivo or not rootPart then return end
        local closest = GetNearestBall()
        if closest and (closest.Position - rootPart.Position).Magnitude < (ReachValor + 2) then
            SkillTimer = SkillTimer + (0.016) * SkillSpeed
            if SkillTimer >= 1 then 
                SkillTimer = 0
                SkillPhase = (SkillPhase + 1) % 4 
            end
            local t = SkillTimer
            local offset
            if SkillPhase == 0 then offset = rootPart.CFrame.LookVector * math.sin(t * math.pi) * 2
            elseif SkillPhase == 1 then offset = rootPart.CFrame.RightVector * math.sin(t * math.pi) * 2
            elseif SkillPhase == 2 then offset = -rootPart.CFrame.RightVector * math.sin(t * math.pi) * 2
            else offset = -rootPart.CFrame.LookVector * math.sin(t * math.pi) * 2 end
            
            local targetPos = rootPart.Position + offset + Vector3.new(0, -1.5, 0)
            closest.CFrame = CFrame.new(closest.Position:Lerp(targetPos, 0.3), closest.Position)
            closest.AssemblyLinearVelocity = Vector3.zero
        end
    end

    local function ExecutarTeclaPress(keyCode)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.01)
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end)
    end

    local function SetAutoZX(estado)
        AutoZXAtivo = estado
        if AutoZXThread then
            task.cancel(AutoZXThread)
            AutoZXThread = nil
        end

        if estado then
            AutoZXThread = task.spawn(function()
                local proximaTecla = Enum.KeyCode.Z
                while AutoZXAtivo do
                    local _, dist = GetNearestBall()
                    if dist <= DISTANCIA_AUTO_ZX then
                        ExecutarTeclaPress(proximaTecla)
                        proximaTecla = (proximaTecla == Enum.KeyCode.Z) and Enum.KeyCode.X or Enum.KeyCode.Z
                        task.wait(0.03)
                    else
                        task.wait(0.1)
                    end
                end
            end)
        end
    end

    local function ApplyLowGraphics()
        if LowGraphicsApplied then return end
        LowGraphicsApplied = true
        pcall(function()
            OriginalGraphicsSettings = {
                GraphicsMode = settings().Rendering.QualityLevel,
                EnableFRM = settings().Rendering.EnableFRM
            }
            settings().Rendering.QualityLevel = 1
            settings().Rendering.EnableFRM = false
            
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Decal") or obj:IsA("Texture") then obj.Texture = "" end
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") then obj.Enabled = false end
            end
        end)
    end

    local function RestoreGraphics()
        if not LowGraphicsApplied then return end
        LowGraphicsApplied = false
        pcall(function()
            if OriginalGraphicsSettings.GraphicsMode then
                settings().Rendering.QualityLevel = OriginalGraphicsSettings.GraphicsMode
            end
        end)
    end

    local function SetAntiLag(estado)
        AntiLagAtivo = estado
        if estado then ApplyLowGraphics() else RestoreGraphics() end
    end

