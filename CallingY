pcall(function()
    local rawget = rawget
    local getrawmetatable = getrawmetatable
    local setreadonly = setreadonly

    if getrawmetatable and setreadonly then
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        local oldIndex = mt.__index
        setreadonly(mt, false)

        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if not checkcaller() and (method == "Kick" or method == "Ban") then
                return nil
            end
            return oldNamecall(self, ...)
        end)

        mt.__index = newcclosure(function(self, key)
            if not checkcaller() and (key == "WalkSpeed" or key == "JumpPower") then
                return 16
            end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
    end
end)

local function ProtectInstance(inst)
    if syn and syn.protect_gui then
        pcall(syn.protect_gui, inst)
    elseif gethui then
        pcall(function() inst.Parent = gethui() end)
    end
end

local function NormalizeKey(text)
    text = tostring(text or "")
    text = text:gsub("%s+", "")
    return text:lower()
end

local function IsValidKey(text)
    local input = NormalizeKey(text)
    if input == NormalizeKey(NORMAL_KEY) then return true end
    for _, key in ipairs(PERMANENT_KEYS) do
        if input == NormalizeKey(key) then return true end
    end
    return false
end

