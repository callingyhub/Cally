    local function StartControllBall()
        if ControlConnection then ControlConnection:Disconnect() end
        if CameraConnection then CameraConnection:Disconnect() end
        if not rootPart or not rootPart.Parent then ControllBall = false; ControlledBall = nil; return end

        local ball = GetNearestBall()
        if not ball or not ball.Parent then
            ControllBall = false
            ControlledBall = nil
            UpdateMobileButton()
            pcall(function()
                Rayfield:Notify({ Title = "Control Ball", Content = "Nenhuma bola encontrada.", Duration = 3 })
            end)
            return
        end

        ControlledBall = ball
        local camera = Workspace.CurrentCamera
        if not camera then ControllBall = false; ControlledBall = nil; return end

        OldCameraType = camera.CameraType
        OldCameraSubject = camera.CameraSubject

        ControllBall = true
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = ControlledBall

        ControlConnection = RunService.RenderStepped:Connect(function()
            if not ControllBall or not ControlledBall or not ControlledBall.Parent then StopControllBall(); return end
            local direction = camera.CFrame.LookVector
            if direction.Magnitude > 0.001 then
                ControlledBall.AssemblyLinearVelocity = direction.Unit * ControlSpeed
            end
        end)

        CameraConnection = RunService.RenderStepped:Connect(function()
            if not ControllBall or not ControlledBall or not ControlledBall.Parent then return end
            camera.CameraType = Enum.CameraType.Custom
            camera.CameraSubject = ControlledBall
        end)

        UpdateMobileButton()
        pcall(function()
            Rayfield:Notify({ Title = "Control Ball", Content = "Controlando a bola selecionada.", Duration = 2 })
        end)
    end

