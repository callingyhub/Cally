    local function UpdateSkyboxColor()
        pcall(function()
            if CustomSkyAtivo then
                Lighting.OutdoorAmbient = CustomSkyColor
                Lighting.Ambient = CustomSkyColor
            else
                Lighting.OutdoorAmbient = OrigOutdoorAmbient
                Lighting.Ambient = Color3.fromRGB(128, 128, 128)
            end
        end)
    end

    local function UpdateGrassColor()
        pcall(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Material == Enum.Material.Grass or obj.Name:lower():find("grass") or obj.Name:lower():find("grama")) then
                    if CustomGrassAtivo then
                        if not OriginalGrassColors[obj] then
                            OriginalGrassColors[obj] = obj.Color
                        end
                        obj.Color = CustomGrassColor
                    else
                        if OriginalGrassColors[obj] then
                            obj.Color = OriginalGrassColors[obj]
                        end
                    end
                end
            end
        end)
    end

    RunService.Heartbeat:Connect(function()
        if not character or not humanoid or not rootPart or humanoid.Health <= 0 then return end
        local ball, distance = GetNearestBall()

        if GKAutoCatch and ball and os.clock() - LastCatch >= GKCooldown and distance <= GKDistance then
            local event = ReplicatedStorage:FindFirstChild("CatchBall")
            if event and event:IsA("RemoteEvent") then
                LastCatch = os.clock()
                event:FireServer(ball)
            end
        end

        ExecutarReachEShoot()
        DoSpin()
        DoSkillMode()
        UpdateReachSphere()
    end)

