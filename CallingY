    local function FireTouch(ball, parte)
        if not ball or not parte or not ball.Parent or not parte.Parent then return false end
        if typeof(firetouchinterest) ~= "function" then return false end
        return pcall(function()
            firetouchinterest(ball, parte, 0)
            task.wait()
            firetouchinterest(ball, parte, 1)
        end)
    end

    local function PararMagnetico()
        BallMagnetico = false
        MagnetBola = nil
        if MagnetConnection then MagnetConnection:Disconnect(); MagnetConnection = nil end
    end

    local function IniciarMagnetico()
        if MagnetConnection then MagnetConnection:Disconnect() end
        MagnetBola = nil
        BallMagnetico = true

        MagnetConnection = RunService.Heartbeat:Connect(function()
            if not BallMagnetico or not rootPart or not rootPart.Parent or not humanoid or humanoid.Health <= 0 then return end
            for _, ball in ipairs(GetBalls()) do
                if ball and ball.Parent then
                    local dist = (ball.Position - rootPart.Position).Magnitude
                    if dist <= MagnetDistancia then
                        local direcao = (rootPart.Position - ball.Position).Unit
                        pcall(function()
                            ball.AssemblyLinearVelocity = direcao * MagnetForca
                        end)
                    end
                end
            end
        end)
    end

    local function SetBallMagnetico(value)
        if value then
            if not BallMagnetico then IniciarMagnetico() end
        else
            PararMagnetico()
        end
    end

    local function ExecutarReachEShoot()
        if not rootPart or not rootPart.Parent then return end

        local todasBolas = GetBalls()
        if #todasBolas == 0 then return end

        local partes = PartesPersonagem()
        local alcanceEfetivo = ReachAtivo and ReachValor or 6

        for _, ball in ipairs(todasBolas) do
            if ball and ball.Parent then
                local tocou = false

                if ReachAtivo then
                    for _, parte in ipairs(partes) do
                        if (ball.Position - parte.Position).Magnitude <= alcanceEfetivo then
                            if FireTouch(ball, parte) then tocou = true end
                        end
                    end
                    if (ball.Position - rootPart.Position).Magnitude <= alcanceEfetivo then
                        if FireTouch(ball, rootPart) then tocou = true end
                    end
                else
                    if (ball.Position - rootPart.Position).Magnitude <= alcanceEfetivo then
                        tocou = true
                    end
                end

                if ShootPowerAtivo and tocou and (os.clock() - UltimoChute) >= 0.08 then
                    UltimoChute = os.clock()
                    local olhar = rootPart.CFrame.LookVector
                    local horizontal = Vector3.new(olhar.X, 0, olhar.Z)
                    local direcaoChute = horizontal.Magnitude > 0.001 and horizontal.Unit or Vector3.new(0, 0, -1)

                    pcall(function()
                        ball.AssemblyLinearVelocity = direcaoChute * ShootPowerForca
                    end)
                end
            end
        end
    end

