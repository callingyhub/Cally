        end
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and BallNames[obj.Name] then return obj end
        end
        return nil
    end

    local function GetBalls()
        local balls = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and BallNames[obj.Name] and obj.Parent then
                table.insert(balls, obj)
            end
        end
        return balls
    end

